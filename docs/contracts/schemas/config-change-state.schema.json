{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "workflow_id",
    "contract_version",
    "change_type",
    "risk_tier",
    "config_kind",
    "state",
    "rework_count",
    "max_rework_attempts",
    "history",
    "evidence",
    "next_route",
    "stop_reason"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "enum": ["config-change"] },
    "contract_version": { "type": "integer", "minimum": 1 },
    "change_type": { "enum": ["config-change"] },
    "risk_tier": { "enum": ["low", "medium"] },
    "config_kind": { "enum": ["feature_flag", "runtime_parameter"] },
    "state": {
      "enum": ["intake", "classifying", "owner-review", "sa-review", "rollout", "monitoring", "rework", "blocked", "complete"]
    },
    "rework_count": { "type": "integer", "minimum": 0 },
    "max_rework_attempts": { "const": 1 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "at", "actor", "evidence_refs"],
        "properties": {
          "from": {
            "enum": ["intake", "classifying", "owner-review", "sa-review", "rollout", "monitoring", "rework", "blocked", "complete"]
          },
          "to": {
            "enum": ["intake", "classifying", "owner-review", "sa-review", "rollout", "monitoring", "rework", "blocked", "complete"]
          },
          "at": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": { "type": "object" },
    "next_route": { "type": "string", "minLength": 1 },
    "stop_reason": { "type": ["string", "null"] }
  }
}
