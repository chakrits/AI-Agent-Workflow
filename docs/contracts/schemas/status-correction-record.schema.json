{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/chakrits/AI-Agent-Workflow/docs/contracts/schemas/status-correction-record.schema.json","title":"Status Correction Record v1","type":"object","additionalProperties":false,"required":["schemaVersion","operation","identity","predecessor","proposal","successor","expected","changedPaths","approval","recordDigest"],"properties":{"schemaVersion":{"const":"status-correction-record/v1"},"operation":{"const":"correction"},"identity":{"$ref":"#/$defs/identity"},"predecessor":{"$ref":"#/$defs/predecessor"},"proposal":{"$ref":"#/$defs/digest"},"successor":{"$ref":"#/$defs/digest"},"expected":{"$ref":"#/$defs/tuple"},"changedPaths":{"$ref":"#/$defs/paths"},"approval":{"$ref":"#/$defs/digest"},"recordDigest":{"$ref":"#/$defs/digest"}},"$defs":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"identity":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"},"predecessor":{"type":"object","additionalProperties":false,"required":["digest","authenticatedBy"],"properties":{"digest":{"$ref":"#/$defs/digest"},"authenticatedBy":{"$ref":"#/$defs/identity"}}},"tuple":{"type":"object","additionalProperties":false,"required":["commitSha","manifestDigest","setDigest","headDigest"],"properties":{"commitSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"manifestDigest":{"$ref":"#/$defs/digest"},"setDigest":{"$ref":"#/$defs/digest"},"headDigest":{"$ref":"#/$defs/digest"}}},"paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*\\u0000)(?!.*\\/$).+$"}}}}
