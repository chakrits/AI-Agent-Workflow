{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chakrits/AI-Agent-Workflow/docs/contracts/schemas/status-writer-intent.schema.json",
  "title": "Status Writer Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "profile", "identity", "toolVersion"],
  "properties": {
    "kind": { "const": "local-cli" },
    "profile": { "const": "disposable-local" },
    "identity": { "type": "string", "pattern": "^local-cli/[a-z][a-z0-9._-]{0,31}$" },
    "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 64 }
  }
}
