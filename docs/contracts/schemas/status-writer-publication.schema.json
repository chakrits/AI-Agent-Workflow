{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chakrits/AI-Agent-Workflow/docs/contracts/schemas/status-writer-publication.schema.json",
  "title": "Disposable Status Writer Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidatePath", "archivePath", "manifestPath", "projectionPath", "defaultRef", "record", "manifest", "projection", "gitCommit"],
  "properties": {
    "candidatePath": { "$ref": "#/$defs/path" },
    "archivePath": { "$ref": "#/$defs/path" },
    "manifestPath": { "$ref": "#/$defs/path" },
    "projectionPath": { "$ref": "#/$defs/path" },
    "defaultRef": { "type": "string", "pattern": "^refs/heads/disposable-[a-z0-9-]+$" },
    "record": { "type": "string" },
    "manifest": { "type": "string" },
    "projection": { "type": "string" },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f\\u2028\\u2029])(?!.*:)(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\.[^/]*)?(?:/|$))(?!.*\\/$).+$"
    }
  }
}
